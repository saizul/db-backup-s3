# AWS S3. Leave S3_ENDPOINT_URL empty. Without keys, the default AWS credential
# chain is used (IAM role on EC2/ECS/EKS, AWS_PROFILE, ...).
S3_BUCKET=my-db-backups
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=AKIAEXAMPLEEXAMPLE
S3_SECRET_ACCESS_KEY=replace-me
# Cheaper storage for backups that are rarely read:
S3_STORAGE_CLASS=STANDARD_IA
