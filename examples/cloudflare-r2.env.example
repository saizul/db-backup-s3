# Cloudflare R2. Create an API token with "Object Read & Write" for the bucket.
# The endpoint contains your account ID (R2 > Overview > S3 API).
S3_BUCKET=my-db-backups
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
