# Backblaze B2 (S3-compatible API). Create an application key restricted to the bucket.
# The endpoint is shown on the bucket page, e.g. s3.us-west-004.backblazeb2.com.
S3_BUCKET=my-db-backups
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_ACCESS_KEY_ID=replace-me-key-id
S3_SECRET_ACCESS_KEY=replace-me
